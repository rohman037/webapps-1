# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security & Secret Management (Production Grade)
# ADMIN_ACCESS_CODE: Plaintext master code (server-side only, will be hashed at runtime)
ADMIN_ACCESS_CODE=""

# ADMIN_SECRET_HASH: SHA-256 hash of the master admin access code
ADMIN_SECRET_HASH=""

# OWNER_SECRET_HASH: SHA-256 hash of the master owner access code
OWNER_SECRET_HASH=""

# OWNER_EMAIL: Email of the master owner / super administrator
OWNER_EMAIL="davidrohman037@gmail.com"

# ADMIN_EMAILS: Comma-separated list of authorized administrator emails
ADMIN_EMAILS="davidrohman037@gmail.com,ahmaddavid0906@gmail.com,globallensn@gmail.com"

# PAYMENT_WEBHOOK_SECRET: Secret key for verifying HMAC SHA-256 payment provider webhooks
PAYMENT_WEBHOOK_SECRET=""

# Observability (Sentry & OpenTelemetry)
SENTRY_DSN_BACKEND=""
SENTRY_DSN_FRONTEND=""
SENTRY_ENVIRONMENT="production"
SENTRY_RELEASE="creator-ai-workspace@1.0.0"
SENTRY_TRACES_SAMPLE_RATE="0.1"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318/v1/traces"

