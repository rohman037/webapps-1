rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unspecified document paths
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Security Helper Functions (Enterprise RBAC via Custom Claims) ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return isSignedIn() ? request.auth.token.get('role', 'user') : 'guest';
    }

    function isSystemOwner() {
      return isSignedIn() && (
        getUserRole() == 'owner' ||
        request.auth.token.get('owner', false) == true ||
        request.auth.token.email == 'davidrohman037@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserRole() == 'owner' ||
        getUserRole() == 'admin' ||
        request.auth.token.get('admin', false) == true ||
        request.auth.token.email in ['davidrohman037@gmail.com', 'ahmaddavid0906@gmail.com', 'globallensn@gmail.com']
      );
    }

    function isModerator() {
      return isSignedIn() && (
        isAdmin() ||
        getUserRole() == 'moderator'
      );
    }

    function isPremium() {
      return isSignedIn() && (
        isModerator() ||
        getUserRole() == 'premium'
      );
    }

    // --- Diagnostic / Health Check (Read-only probe) ---
    match /_healthCheck/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // --- User Accounts ---
    // Users can read/write their own profile; admins can read/manage all
    // Clients cannot escalate privileges by updating 'role' or 'permissions'
    match /users/{userId} {
      allow read: if isOwnerUser(userId) || isAdmin();
      allow create: if isOwnerUser(userId) && (!request.resource.data.keys().hasAny(['role', 'permissions']));
      allow update: if (isOwnerUser(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Clients & Subscriptions ---
    // Admin can manage all; client can read their own record if email matches token
    match /clients/{clientId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow write: if isAdmin();
    }

    // --- Pricing Packages ---
    // Public can read packages to choose a plan; only admins can edit packages
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- System Configuration (QRIS, Contact, UI Theme) ---
    // Public can read configuration for theme/QRIS; only admins can write
    match /configs/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Payment Verification & Transactions ---
    // Users can create transaction records and read their own; only admins can verify/approve/reject/update
    match /transactions/{transactionId} {
      allow create: if true;
      allow read: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email));
      allow update, delete: if isAdmin();
    }

    // --- AI Generation History ---
    // User can read and manage their own history; admins can view
    match /history/{historyId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // --- Access Codes Repository (Server / Admin Protected) ---
    // Direct client manipulation blocked; managed via server-side verification and Admin
    match /accessCodes/{codeId} {
      allow read, write: if isAdmin();
    }

    // --- Announcements & Broadcasts ---
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin() || isModerator();
    }

    // --- Prompt Formulas ---
    match /promptFormulas/{formulaId} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isAdmin() || isModerator();
    }

    // --- Affiliate & Referral System ---
    match /affiliates/{affiliateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- API Key Pool (CRITICAL: ZERO CLIENT ACCESS - SERVER ONLY) ---
    match /apiKeys/{apiKeyId} {
      allow read, write: if false;
    }

    // --- API Key Logs (SERVER ONLY) ---
    match /apiKeyUsageLogs/{logId} {
      allow read, write: if false;
    }
    match /apiKeyLogs/{logId} {
      allow read, write: if false;
    }

    // --- AI Agents Registry ---
    match /aiAgents/{agentId} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isAdmin();
    }

    // --- Administrative Audit Logs (SERVER ONLY WRITES, ADMIN READ) ---
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // --- Self-Learning Pattern Queue ---
    match /learningQueue/{queueId} {
      allow read, write: if isAdmin();
    }

    // --- Video Taxonomy ---
    match /categoryTaxonomy/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categoryTaxonomyProposals/{proposalId} {
      allow read, write: if isAdmin();
    }

    // --- Telemetry & Tracking Events (SERVER ONLY) ---
    match /trackingEvents/{eventId} {
      allow read, write: if false;
    }

    // --- Banned Devices Blacklist (SERVER ONLY) ---
    match /bannedDevices/{deviceId} {
      allow read, write: if false;
    }

    // --- Pending Schema Proposals ---
    match /pendingSchemaChanges/{changeId} {
      allow read, write: if isAdmin();
    }

    // --- Trend Videos ---
    match /trend_videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /trendVideos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
